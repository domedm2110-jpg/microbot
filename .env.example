# ── API KEY DE ANTHROPIC ──────────────────────────────────────────────
# Obtén la tuya en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-aqui-va-tu-api-key

# ── CONTRASEÑA DEL DASHBOARD ──────────────────────────────────────────
# Cambia esto por una contraseña segura
DASHBOARD_PASSWORD=profesor123

# ── BASE DE DATOS ─────────────────────────────────────────────────────
# Ruta del archivo SQLite (por defecto: microbot.db en la raíz)
# En Railway agrega un volumen y cambia esta ruta si necesitas persistencia
DB_PATH=./microbot.db

# ── PUERTO ────────────────────────────────────────────────────────────
# Railway y Render lo asignan automáticamente, no es necesario cambiarlo
PORT=3000
